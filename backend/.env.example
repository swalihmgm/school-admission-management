# Server Environment & Port Configuration
NODE_ENV=production
PORT=3001

# MongoDB Connection String (MongoDB Atlas or Self-Hosted Instance)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/school_admission?retryWrites=true&w=majority

# JWT Authentication Secrets (Must be min 32-character random secure strings in production)
JWT_ACCESS_SECRET=your_super_secret_production_access_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_production_refresh_key_min_32_chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Frontend CORS Origin URL (Comma-separated for multiple origins, no trailing slashes)
FRONTEND_URL=https://your-school-frontend.vercel.app

# Razorpay Integration Credentials
RAZORPAY_KEY_ID=rzp_test_dummy_key_id
RAZORPAY_KEY_SECRET=rzp_test_dummy_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_dummy_webhook_secret

# Mock Payment V1 Simulator Flag (Set to true to retain simulated test checkout)
PAYMENT_SIMULATOR_ENABLED=true

# Initial Admin Auto-Provisioning Credentials
ADMIN_FULL_NAME=Admission Team Admin
ADMIN_EMAIL=admin@school.com
ADMIN_PASSWORD=ChangeThisStrongAdminPassword123!

